<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        tools:context=".MainActivity">
    <EditText
            android:id="@+id/cost_of_service"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:inputType="text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:hint="@string/cost_of_service_hint"
            android:minHeight="48dp"
            android:layout_marginTop="10dp"
            android:textSize="@dimen/TextFontSizePrim"/>
    <TextView
            android:id="@+id/like_service"
            android:text="@string/likeService_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:layout_editor_absoluteX="56dp"
            app:layout_constraintTop_toBottomOf="@id/cost_of_service"
            app:layout_constraintStart_toStartOf="parent"
            android:textSize="@dimen/TextFontSizeSec"
            android:layout_marginTop="@dimen/MarginBetweenFields"
    />

    <RadioGroup
            android:id="@+id/tip_options"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/like_service"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:checkedButton="@id/option_twenty_percent"
    >
        <RadioButton
                android:id="@+id/option_twenty_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exelent_20"
                android:textSize="@dimen/TextFontSizePrim"
        />

        <RadioButton
                android:id="@+id/option_ten_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/good_10"
                android:textSize="@dimen/TextFontSizePrim"
                android:layout_marginTop="@dimen/MarginBetweenFields"
        />

        <RadioButton
                android:id="@+id/option_five_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/can_be_better_5"
                android:textSize="@dimen/TextFontSizePrim"
                android:layout_marginTop="@dimen/MarginBetweenFields"
        />
    </RadioGroup>

    <Switch
            android:id="@+id/round_up_switch"
            app:layout_constraintStart_toStartOf="@id/tip_options"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tip_options"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/should_i_round"
            android:layout_marginTop="@dimen/MarginBetweenFields"
            android:textSize="@dimen/TextFontSizePrim"
    />

    <Button
            android:id="@+id/button_calculate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/MarginBetweenFields"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/round_up_switch"
            android:text="@string/calculate_button_content"
            android:textSize="@dimen/TextFontSizePrim"
    />

    <TextView
            android:id="@+id/tip_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/button_calculate"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/MarginBetweenFields"
            android:textSize="@dimen/TextFontSizePrim"
            android:hint="@string/calculated_result_hint"
    />


</androidx.constraintlayout.widget.ConstraintLayout>